{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "color": {
      "palette": [
        {
          "slug": "base",
          "name": "Base",
          "color": "#faf9f6"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#202724"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#25634a"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(1rem, 4vw, 3rem)",
        "right": "clamp(1rem, 4vw, 3rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "fontSize": "1.125rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        }
      },
      "heading": {
        "typography": {
          "lineHeight": "1.2"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
